# ==============================================================================
# Tarang Radio - Environment Configuration
# ==============================================================================

# Server Port (Default: 4000)
PORT=4000

# Node Environment: 'production' or 'development'
NODE_ENV=production

# Database Connection URL (PostgreSQL)
# Format: postgres://username:password@host:port/database?sslmode=require
# Examples:
#   Local Docker: postgres://tarang:tarang_password_demo@localhost:5432/tarang
#   Supabase:     postgres://postgres:[YOUR-PASSWORD]@db.[REF].supabase.co:5432/postgres
#   Neon:         postgres://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require
#   Render:       postgres://[USER]:[PASSWORD]@[HOST].render.com/[DB]
# NOTE: If DATABASE_URL is omitted, Tarang runs on its resilient persistent file storage!
DATABASE_URL=postgres://tarang:tarang_password_demo@localhost:5432/tarang

# Allowed CORS Origins (set to * or your domain, e.g. https://tarang.fm)
CORS_ORIGIN=*

# JWT Secret for creator/listener sessions
JWT_SECRET=tarang_super_secret_production_key_change_in_real_launch

# LiveKit SFU (Optional: For WebRTC ingest if scaling beyond client WebAudio)
LIVEKIT_URL=wss://tarang-demo.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
